{
  "name": "hercules",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Hercules \u2014 personal fitness and physical performance operating system (PWA).",
  "scripts": {
    "start": "npx --yes serve -l 5173 .",
